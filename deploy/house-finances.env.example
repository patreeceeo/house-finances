# /etc/house-finances.env (chmod 640, owned by root:housefin)
HOUSEFIN_DB=/srv/house-finances/finances.db
# From Zero Trust > Access > Applications: the team domain and the app's AUD tag.
HOUSEFIN_ACCESS_TEAM_DOMAIN=myhouse.cloudflareaccess.com
HOUSEFIN_ACCESS_AUD=paste-the-aud-tag-here
# Can change data; anyone else Access lets in can only look.
HOUSEFIN_EDITORS=you@example.com,housemate@example.com
# Backups (deploy/backup.sh): an rclone remote and folder, and days kept on the server.
RCLONE_REMOTE=b2:house-finances-backups
KEEP_DAYS=14
